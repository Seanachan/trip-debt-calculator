rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // An account's own index of trips it has joined. Private to that account:
    // it names room codes, and a room code is the credential for a group.
    match /users/{uid}/trips/{groupId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /groups/{groupId} {
      // `get` (single doc by known room code) but NOT `list`: the 6-char code
      // is the shared secret, so nobody can enumerate the groups collection.
      // No whole-group delete.
      allow get, create, update: if request.auth != null;

      match /members/{memberId} {
        allow read, write: if request.auth != null;
      }

      match /settlements/{rowId} {
        // "This transfer actually happened" — shared, so every traveller sees
        // the same ticks. Same trust model as expenses: holding the room code
        // is the credential. Document id encodes (from, to, amount).
        allow read, delete: if request.auth != null;
        allow create, update: if request.auth != null
          && request.resource.data.settledAt is int
          && request.resource.data.settledBy is string;
      }

      match /expenses/{expenseId} {
        allow read: if request.auth != null;
        allow delete: if request.auth != null;
        allow create, update: if request.auth != null
          && request.resource.data.amount is int
          && request.resource.data.amount > 0;
      }
    }
  }
}
