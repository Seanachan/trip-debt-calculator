# Firebase config for the Trip Debt Calculator feature
# (src/features/expense-divider), used for live multiplayer via Firestore.
#
# Get real values from the Firebase console:
#   Project settings > General > Your apps > SDK setup and configuration
#
# These are public client identifiers, not secrets — it's safe for them to
# ship in the client bundle. Access control is enforced by firestore.rules
# (signed-in requests only), not by hiding this config.
#
# Copy this file to .env.local and fill in the values for local dev.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: reCAPTCHA Enterprise site key for App Check, which 拍收據 (receipt
# scan through Firebase AI Logic) requires. Leave empty to hide the feature.
# Setup steps: docs/specs/receipt-scan.md → "Setup".
VITE_RECAPTCHA_ENTERPRISE_KEY=
